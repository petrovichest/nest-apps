#!/usr/bin/env bash

set -euo pipefail

codexnest_root="${CODEXNEST_ROOT:-$HOME/.local/share/codexnest}"
codexnest_repository="${CODEXNEST_REPOSITORY_URL:-https://github.com/petrovichest/nest-apps.git}"
codexnest_source="$codexnest_root/source"
codexnest_releases="$codexnest_root/releases"
codexnest_current="$codexnest_root/current"
codexnest_previous="$codexnest_root/previous"
codexnest_config="${XDG_CONFIG_HOME:-$HOME/.config}/codexnest/server.env"
codexnest_state_root="${XDG_STATE_HOME:-$HOME/.local/state}/codexnest"
codexnest_update_status="$codexnest_state_root/update.json"
codexnest_restart_token_default="$codexnest_state_root/restart-token"
codexnest_service_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
codexnest_rolling_manifest_url="https://github.com/petrovichest/nest-apps/releases/download/rolling-latest/NestApps-latest.json"
codexnest_preflight_error=""

codexnest_die() {
  printf 'codexnest: %s\n' "$1" >&2
  exit 1
}

codexnest_current_version() {
  local target
  target="$(readlink -f "$codexnest_current" 2>/dev/null || true)"
  [[ -n "$target" ]] || codexnest_die "managed installation is not available"
  basename "$target" | sed 's/^v//'
}

codexnest_current_commit() {
  local target
  target="$(readlink -f "$codexnest_current" 2>/dev/null || true)"
  [[ -n "$target" ]] || codexnest_die "managed installation is not available"
  git -C "$target" rev-parse HEAD 2>/dev/null
}

codexnest_config_value() {
  local key="$1"
  [[ -f "$codexnest_config" ]] || return 1
  awk -F= -v key="$key" '
    $1 == key {
      sub(/^[^=]*=/, "")
      print
      exit
    }
  ' "$codexnest_config"
}

codexnest_restart_token_path() {
  local configured
  configured="$(codexnest_config_value CODEXNEST_RESTART_TOKEN_PATH || true)"
  printf '%s\n' "${configured:-$codexnest_restart_token_default}"
}

codexnest_release_recovery_protocol() {
  local release="$1"
  local manifest="$release/deploy/restart-protocol.json"
  local node_bin="$codexnest_root/runtime/current/bin/node"
  [[ -f "$manifest" && -x "$node_bin" ]] || {
    printf '0\n'
    return
  }
  "$node_bin" -e '
    const fs = require("node:fs");
    const value = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const protocol = value.runtimeRecoveryProtocolVersion ?? value.recoveryProtocolVersion;
    if (
      value.schemaVersion !== 1 ||
      !Number.isInteger(protocol) ||
      protocol < 1
    ) process.exit(1);
    process.stdout.write(String(protocol));
  ' "$manifest"
}

codexnest_update_channel() {
  local channel="${CODEXNEST_UPDATE_CHANNEL:-}"
  if [[ -z "$channel" ]]; then
    channel="$(codexnest_config_value CODEXNEST_UPDATE_CHANNEL || true)"
  fi
  channel="${channel:-rolling}"
  case "$channel" in
    rolling|stable) printf '%s\n' "$channel" ;;
    *) codexnest_die "CODEXNEST_UPDATE_CHANNEL must be rolling or stable" ;;
  esac
}

codexnest_latest_tag() {
  local node_bin="$codexnest_root/runtime/current/bin/node"
  [[ -x "$node_bin" ]] || codexnest_die "managed Node.js runtime is missing"
  curl -fsSL \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' \
    'https://api.github.com/repos/petrovichest/nest-apps/releases?per_page=100' \
    | "$node_bin" -e '
        const fs = require("node:fs");
        const releases = JSON.parse(fs.readFileSync(0, "utf8"));
        if (!Array.isArray(releases)) process.exit(1);
        const stable = releases
          .filter((release) =>
            !release.draft &&
            !release.prerelease &&
            typeof release.tag_name === "string" &&
            /^v\d+\.\d+\.\d+$/.test(release.tag_name))
          .map((release) => ({
            tag: release.tag_name,
            parts: release.tag_name.slice(1).split(".").map(Number),
          }))
          .sort((left, right) => {
            for (let index = 0; index < 3; index += 1) {
              if (left.parts[index] !== right.parts[index]) {
                return right.parts[index] - left.parts[index];
              }
            }
            return 0;
          })[0];
        if (!stable) process.exit(1);
        process.stdout.write(stable.tag);
      '
}

codexnest_latest_candidate() {
  local channel="$1" node_bin tag
  if [[ "$channel" == stable ]]; then
    tag="$(codexnest_latest_tag)"
    printf '%s\t%s\n' "${tag#v}" "$tag"
    return
  fi
  node_bin="$codexnest_root/runtime/current/bin/node"
  [[ -x "$node_bin" ]] || codexnest_die "managed Node.js runtime is missing"
  curl -fsSL \
    -H 'Cache-Control: no-cache' \
    "$codexnest_rolling_manifest_url?cache=$(date +%s)-$$" \
    | "$node_bin" -e '
        const fs = require("node:fs");
        const manifest = JSON.parse(fs.readFileSync(0, "utf8"));
        const version = typeof manifest.version === "string" ? manifest.version : "";
        const commit = typeof manifest.commit === "string" ? manifest.commit : "";
        if (
          manifest.schemaVersion !== 1 ||
          !/^\d+\.\d+\.\d+-[0-9a-f]{7}$/.test(version) ||
          !/^[0-9a-f]{40}$/.test(commit) ||
          !version.endsWith(`-${commit.slice(0, 7)}`)
        ) {
          process.exit(1);
        }
        process.stdout.write(`${version}\t${commit}`);
      '
}

codexnest_version_greater() {
  [[ "$(printf '%s\n%s\n' "$1" "$2" | sed 's/^v//' | sort -V | tail -n 1)" == "${1#v}" && "${1#v}" != "${2#v}" ]]
}

codexnest_candidate_available() {
  local channel="$1" latest_version="$2" latest_ref="$3"
  if [[ "$channel" == rolling ]]; then
    [[ "$(codexnest_current_commit)" != "$latest_ref" ]]
  else
    codexnest_version_greater "$latest_version" "$(codexnest_current_version)"
  fi
}

codexnest_json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]/ /g'
}

codexnest_write_status() {
  local operation="$1" result="$2" message="$3" latest="$4" available="$5"
  local current timestamp temporary latest_json message_json
  current="$(codexnest_current_version)"
  timestamp="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  temporary="$codexnest_update_status.$$"
  latest_json=null
  [[ -z "$latest" ]] || latest_json="\"$(codexnest_json_escape "${latest#v}")\""
  message_json=null
  [[ -z "$message" ]] || message_json="\"$(codexnest_json_escape "$message")\""
  mkdir -p "$codexnest_state_root"
  chmod 700 "$codexnest_state_root"
  umask 077
  printf '{"supported":true,"currentVersion":"%s","latestVersion":%s,"updateAvailable":%s,"operation":"%s","result":"%s","message":%s,"checkedAt":"%s","updatedAt":"%s"}\n' \
    "$current" "$latest_json" "$available" "$operation" "$result" "$message_json" "$timestamp" "$timestamp" > "$temporary"
  mv -f "$temporary" "$codexnest_update_status"
}

codexnest_print_check_json() {
  local current channel candidate latest_version latest_ref available timestamp
  current="$(codexnest_current_version)"
  channel="$(codexnest_update_channel)"
  candidate="$(codexnest_latest_candidate "$channel")"
  IFS=$'\t' read -r latest_version latest_ref <<< "$candidate"
  [[ -n "$latest_version" && -n "$latest_ref" ]] || codexnest_die "no CodexNest updates are available"
  available=false
  if codexnest_candidate_available "$channel" "$latest_version" "$latest_ref"; then
    available=true
  fi
  codexnest_write_status idle none "Update check completed" "$latest_version" "$available"
  timestamp="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  printf '{"supported":true,"currentVersion":"%s","latestVersion":"%s","updateAvailable":%s,"operation":"idle","result":"none","message":"Update check completed","checkedAt":"%s","updatedAt":"%s"}\n' \
    "$current" "$latest_version" "$available" "$timestamp" "$timestamp"
}

codexnest_set_env_value() {
  local key="$1" value="$2" temporary
  temporary="$codexnest_config.$$"
  mkdir -p "$(dirname "$codexnest_config")"
  if [[ -f "$codexnest_config" ]]; then
    awk -v key="$key" -v value="$value" '
      BEGIN { replaced = 0 }
      index($0, key "=") == 1 { print key "=" value; replaced = 1; next }
      { print }
      END { if (!replaced) print key "=" value }
    ' "$codexnest_config" > "$temporary"
  else
    printf '%s=%s\n' "$key" "$value" > "$temporary"
  fi
  chmod 600 "$temporary"
  mv -f "$temporary" "$codexnest_config"
}

codexnest_install_assets() {
  local release="$1"
  install -m 0755 "$release/deploy/codexnest" "$HOME/.local/bin/codexnest" || return 1
  install -m 0644 "$release/deploy/systemd/codexnest-managed.service" \
    "$codexnest_service_dir/codexnest.service" || return 1
  install -m 0644 "$release/deploy/systemd/codexnest-update.service" \
    "$codexnest_service_dir/codexnest-update.service" || return 1
  systemctl --user daemon-reload
}

codexnest_switch_release() {
  local target="$1" temporary="$codexnest_root/.current.$$"
  ln -s "$target" "$temporary" || return 1
  mv -Tf "$temporary" "$codexnest_current"
}

codexnest_health_ok() {
  local expected="$1" attempt body node_bin current_target expected_protocol
  local attempts="${CODEXNEST_HEALTH_ATTEMPTS:-120}"
  local delay_seconds="${CODEXNEST_HEALTH_DELAY_SECONDS:-1}"
  [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || attempts=120
  [[ "$delay_seconds" =~ ^[0-9]+([.][0-9]+)?$ ]] || delay_seconds=1
  node_bin="$codexnest_root/runtime/current/bin/node"
  current_target="$(readlink -f "$codexnest_current" 2>/dev/null || true)"
  expected_protocol="$(codexnest_release_recovery_protocol "$current_target")" || return 1
  for ((attempt = 1; attempt <= attempts; attempt += 1)); do
    body="$(curl --noproxy '*' --fail --silent --show-error \
      http://127.0.0.1:4310/api/v1/health 2>/dev/null || true)"
    if printf '%s' "$body" | "$node_bin" -e '
      const fs = require("node:fs");
      let value;
      try { value = JSON.parse(fs.readFileSync(0, "utf8")); } catch { process.exit(1); }
      process.exit(
        value.serverVersion === process.argv[1] &&
        value.status === "ok" &&
        (Number(process.argv[2]) === 0 || value.recoveryState === "ready") ? 0 : 1
      );
    ' "$expected" "$expected_protocol"; then return 0; fi
    sleep "$delay_seconds"
  done
  return 1
}

codexnest_resume_after_aborted_restart() {
  local token_path token
  token_path="$(codexnest_restart_token_path)"
  [[ -f "$token_path" ]] || return
  token="$(tr -d '\r\n' < "$token_path")"
  [[ -n "$token" ]] || return
  curl --noproxy '*' --fail --silent --show-error \
    --connect-timeout 5 \
    --max-time 10 \
    -X POST \
    -H "X-CodexNest-Restart-Token: $token" \
    http://127.0.0.1:4310/api/v1/internal/restart/resume \
    >/dev/null 2>&1 || true
}

codexnest_prepare_restart() {
  local target="$1" target_protocol token_path token body node_bin
  codexnest_preflight_error=""
  target_protocol="$(codexnest_release_recovery_protocol "$target")" || return 1
  token_path="$(codexnest_restart_token_path)"
  [[ -f "$token_path" ]] || return 1
  token="$(tr -d '\r\n' < "$token_path")"
  [[ -n "$token" ]] || return 1
  node_bin="$codexnest_root/runtime/current/bin/node"
  if ! body="$(curl --noproxy '*' --fail-with-body --silent --show-error \
    --connect-timeout 5 \
    --max-time 75 \
    -X POST \
    -H "X-CodexNest-Restart-Token: $token" \
    http://127.0.0.1:4310/api/v1/internal/restart/prepare)"; then
    codexnest_preflight_error="$(printf '%s' "$body" | "$node_bin" -e '
      const fs = require("node:fs");
      try {
        const value = JSON.parse(fs.readFileSync(0, "utf8"));
        const message = typeof value?.error?.message === "string" ? value.error.message.trim() : "";
        if (message) process.stdout.write(message.slice(0, 500));
      } catch {}
    ' 2>/dev/null || true)"
    codexnest_resume_after_aborted_restart
    return 1
  fi
  if ! printf '%s' "$body" | "$node_bin" -e '
    const fs = require("node:fs");
    const value = JSON.parse(fs.readFileSync(0, "utf8"));
    const targetProtocol = Number(process.argv[1]);
    const compatible =
      value.transport === "daemon" &&
      value.appServerReady === true &&
      value.restartProtocolVersion === targetProtocol;
    process.exit(compatible || value.quiescent === true ? 0 : 1);
  ' "$target_protocol"; then
    codexnest_preflight_error="The target release cannot safely recover the current CodexNest work"
    codexnest_resume_after_aborted_restart
    return 2
  fi
}

codexnest_build_release() {
  local ref="$1" version="$2" target node_bin resolved_ref
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9a-f]{7})?$ ]] || return 1
  target="$codexnest_releases/v$version"
  [[ "$target" == "$codexnest_releases"/v* ]] || codexnest_die "invalid release path"
  git -C "$codexnest_source" remote set-url origin "$codexnest_repository" || return 1
  git -C "$codexnest_source" fetch --prune origin \
    '+refs/heads/*:refs/remotes/origin/*' \
    'refs/tags/v*:refs/tags/v*' || return 1
  resolved_ref="$(git -C "$codexnest_source" rev-parse "$ref^{commit}" 2>/dev/null)" || return 1
  if [[ -f "$target/.codexnest-built" && \
        "$(cat "$target/.codexnest-built")" == "$resolved_ref" && \
        -f "$target/apps/server/dist/index.js" && \
        -f "$target/apps/client/dist/index.html" ]]; then
    return
  fi
  git -C "$codexnest_source" worktree remove --force "$target" 2>/dev/null || true
  if [[ -e "$target" ]]; then
    rm -rf -- "$target"
  fi
  git -C "$codexnest_source" worktree prune || return 1
  git -C "$codexnest_source" worktree add --detach "$target" "$resolved_ref" || return 1
  node_bin="$codexnest_root/runtime/current/bin"
  if ! (
    cd "$target" &&
    PATH="$node_bin:$PATH" "$node_bin/npm" ci &&
    PATH="$node_bin:$PATH" CODEXNEST_VERSION="$version" "$node_bin/npm" run build &&
    printf '%s\n' "$resolved_ref" > .codexnest-built
  ); then
    git -C "$codexnest_source" worktree remove --force "$target" || true
    return 1
  fi
}

codexnest_restore_release() {
  local target="$1" version="$2" latest="$3" reason="$4" restored=true preflight_status=0 target_protocol
  codexnest_prepare_restart "$target" || preflight_status=$?
  target_protocol="$(codexnest_release_recovery_protocol "$target" 2>/dev/null || printf '0\n')"
  if [[ "$preflight_status" -eq 2 || \
        ( "$preflight_status" -ne 0 && "$target_protocol" -lt 1 ) ]]; then
    codexnest_write_status idle failed \
      "$reason; automatic rollback could not prove that the older release would protect active work" \
      "$latest" true
    return 1
  fi
  codexnest_switch_release "$target" || restored=false
  codexnest_set_env_value CODEXNEST_VERSION "$version" || restored=false
  codexnest_install_assets "$target" || restored=false
  systemctl --user restart codexnest.service || restored=false
  if $restored && codexnest_health_ok "$version"; then
    codexnest_write_status idle rolled_back "$reason; the previous release was restored" "$latest" true
  else
    codexnest_write_status idle failed "$reason; automatic rollback also failed" "$latest" true
  fi
}

codexnest_update_worker() {
  local channel candidate latest_version latest_ref target old_target old_version
  channel="$(codexnest_update_channel)"
  if ! candidate="$(codexnest_latest_candidate "$channel")"; then
    codexnest_write_status idle failed "Failed to discover CodexNest updates" "" false
    return 1
  fi
  IFS=$'\t' read -r latest_version latest_ref <<< "$candidate"
  if [[ -z "$latest_version" || -z "$latest_ref" ]]; then
    codexnest_write_status idle failed "Failed to validate the CodexNest update" "" false
    return 1
  fi
  if ! codexnest_candidate_available "$channel" "$latest_version" "$latest_ref"; then
    codexnest_write_status idle none "CodexNest is already up to date" "$latest_version" false
    return
  fi
  codexnest_write_status preparing none "Preparing CodexNest $latest_version" "$latest_version" true
  target="$codexnest_releases/v$latest_version"
  codexnest_write_status building none "Building CodexNest $latest_version" "$latest_version" true
  codexnest_build_release "$latest_ref" "$latest_version" || {
    codexnest_write_status idle failed "Failed to build CodexNest $latest_version" "$latest_version" true
    return 1
  }
  codexnest_write_status preparing none \
    "Preparing CodexNest $latest_version to restart" "$latest_version" true
  if ! codexnest_prepare_restart "$target"; then
    codexnest_write_status idle failed \
      "${codexnest_preflight_error:-CodexNest restart preflight failed or the target cannot recover current work}" \
      "$latest_version" true
    return 1
  fi
  codexnest_write_status switching none "Switching to CodexNest $latest_version" "$latest_version" true
  old_target="$(readlink -f "$codexnest_current")"
  [[ "$old_target" == "$codexnest_releases"/* ]] || codexnest_die "invalid current release path"
  old_version="$(basename "$old_target" | sed 's/^v//')"
  if ! ln -sfn "$old_target" "$codexnest_previous"; then
    codexnest_resume_after_aborted_restart
    codexnest_write_status idle failed "Failed to prepare rollback for CodexNest $latest_version" "$latest_version" true
    return 1
  fi
  if ! codexnest_switch_release "$target" || \
     ! codexnest_set_env_value CODEXNEST_VERSION "$latest_version" || \
     ! codexnest_install_assets "$target" || \
     ! codexnest_write_status restarting none "Restarting CodexNest $latest_version" "$latest_version" true || \
     ! codexnest_prepare_restart "$target" || \
     ! systemctl --user restart codexnest.service; then
    codexnest_restore_release "$old_target" "$old_version" "$latest_version" \
      "Failed to activate CodexNest $latest_version"
    return 1
  fi
  if codexnest_health_ok "$latest_version"; then
    codexnest_write_status idle updated "CodexNest was updated successfully" "$latest_version" false
    return
  fi
  codexnest_restore_release "$old_target" "$old_version" "$latest_version" \
    "CodexNest $latest_version failed its health check"
  return 1
}

codexnest_repair() {
  local codex_bin
  codex_bin="$(command -v codex 2>/dev/null || true)"
  [[ -n "$codex_bin" ]] || codexnest_die "Codex CLI is not installed; install it and run codexnest repair again"
  codexnest_set_env_value CODEXNEST_CODEX_BIN "$codex_bin"
  codexnest_set_env_value CODEXNEST_CODEX_MANAGEMENT_BIN "$codex_bin"
  "$codex_bin" app-server daemon bootstrap
  systemctl --user restart codexnest.service
  codexnest_health_ok "$(codexnest_current_version)" || codexnest_die "CodexNest did not become healthy"
  printf 'CodexNest and Codex daemon are ready.\n'
}

codexnest_rollback() {
  local target current version
  target="$(readlink -f "$codexnest_previous" 2>/dev/null || true)"
  current="$(readlink -f "$codexnest_current" 2>/dev/null || true)"
  [[ -n "$target" && -d "$target" ]] || codexnest_die "no previous release is available"
  [[ "$target" == "$codexnest_releases"/* ]] || codexnest_die "invalid previous release path"
  if ! codexnest_prepare_restart "$target"; then
    codexnest_die "rollback cannot safely recover the current CodexNest work"
  fi
  ln -sfn "$current" "$codexnest_previous"
  codexnest_switch_release "$target"
  version="$(basename "$target" | sed 's/^v//')"
  codexnest_set_env_value CODEXNEST_VERSION "$version"
  codexnest_install_assets "$target"
  codexnest_prepare_restart "$target" || codexnest_die "rollback preflight expired"
  systemctl --user restart codexnest.service
  codexnest_health_ok "$version" || codexnest_die "rolled back release did not become healthy"
  printf 'Rolled back to CodexNest %s.\n' "$version"
}

codexnest_restart() {
  local target
  target="$(readlink -f "$codexnest_current" 2>/dev/null || true)"
  [[ -n "$target" && -d "$target" ]] || codexnest_die "managed installation is not available"
  codexnest_prepare_restart "$target" || codexnest_die "restart preflight failed"
  systemctl --user restart codexnest.service
  codexnest_health_ok "$(codexnest_current_version)" || codexnest_die "CodexNest did not recover"
}

codexnest_doctor() {
  local failed=0
  printf 'CodexNest version: %s\n' "$(codexnest_current_version)"
  if systemctl --user is-active --quiet codexnest.service; then
    printf 'Service: active\n'
  else
    printf 'Service: inactive\n'
    failed=1
  fi
  if command -v codex >/dev/null 2>&1; then
    codex --version || failed=1
  else
    printf 'Codex CLI: not installed (run codexnest repair after installing it)\n'
  fi
  curl --noproxy '*' --fail --silent --show-error \
    http://127.0.0.1:4310/api/v1/health || failed=1
  printf '\n'
  return "$failed"
}

case "${1:-help}" in
  status) systemctl --user status codexnest.service --no-pager ;;
  logs) journalctl --user -u codexnest.service -n 100 --no-pager "${@:2}" ;;
  doctor) codexnest_doctor ;;
  repair) codexnest_repair ;;
  check-update) codexnest_print_check_json ;;
  update) systemctl --user start codexnest-update.service; cat "$codexnest_update_status" ;;
  update-worker) codexnest_update_worker ;;
  rollback) codexnest_rollback ;;
  restart) codexnest_restart ;;
  *)
    printf '%s\n' 'Usage: codexnest status|logs|doctor|repair|check-update|update|rollback|restart'
    ;;
esac
