CLAUDENEST_HOST=127.0.0.1
CLAUDENEST_PORT=4311
CLAUDENEST_RELEASE_PATH=/home/owner/.local/share/claudenest/releases/COMMIT
CLAUDENEST_RUNNER_PATH=/home/owner/.local/share/claudenest/releases/COMMIT/apps/claude-server/dist/runner-main.js
CLAUDENEST_TOKEN_FILE=/home/owner/.config/claudenest/token
CLAUDENEST_SERVER_ENV_FILE=/home/owner/.config/claudenest/server.env
# CLAUDENEST_CLAUDE_BIN=/absolute/path/to/installed/claude
# CLAUDE_CONFIG_DIR=/home/owner/.claude
CLAUDENEST_ALLOWED_ORIGINS=http://127.0.0.1:4311,http://localhost:4311,http://127.0.0.1:5174,http://localhost:5174,https://claude.home.arpa,http://claude.home.arpa
# Put any required proxy settings here; never put secrets in service arguments.
