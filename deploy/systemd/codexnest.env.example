# Safe example only. Store this as ~/.config/codexnest/server.env with mode 0600.
NODE_ENV=production
CODEXNEST_HOST=127.0.0.1
CODEXNEST_PORT=4310
CODEXNEST_ALLOWED_ORIGINS=https://codexnest.lan,http://localhost
CODEXNEST_STATE_PATH=/home/CHANGE_ME/.local/state/codexnest/state.json
CODEXNEST_DATABASE_PATH=/home/CHANGE_ME/.local/state/codexnest/state.sqlite
# Optional absolute directory allowed in the project picker; defaults to the service user's home.
# CODEXNEST_PROJECT_ROOT=/home/CHANGE_ME
CODEXNEST_CODEX_BIN=/home/CHANGE_ME/.local/bin/codex
CODEXNEST_CODEX_MANAGEMENT_BIN=/home/CHANGE_ME/bin/codex
CODEXNEST_CODEX_PROXY_ENV_FILE=/home/CHANGE_ME/.config/codex/app-server.env
CODEXNEST_CODEX_TRANSPORT=daemon
# Optional: delete the oldest inactive, unpinned sessions in background batches.
CODEXNEST_SESSION_LIMIT=400

# Speech-to-text providers are global for every client. Configure one active mode.
# CODEXNEST_STT_PROVIDER=local
# CODEXNEST_STT_LOCAL_URL=http://127.0.0.1:8178/inference
# CODEXNEST_STT_OPENAI_API_KEY=sk-CHANGE_ME
# CODEXNEST_STT_OPENAI_MODEL=gpt-4o-transcribe
# CODEXNEST_STT_LANGUAGE=ru
# CODEXNEST_STT_REFINE_LOCAL=true
# CODEXNEST_STT_REFINEMENT_MODEL=gpt-5.6-luna
# CODEXNEST_STT_TIMEOUT_MS=600000
