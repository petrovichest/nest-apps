{
  "name": "@opennest/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/native.ts src/plugin.ts --format esm --platform node --target node24 --sourcemap --out-dir dist --clean --no-splitting",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test ../../deploy/opennest/manage.test.mjs ../../deploy/opennest/update.test.mjs ../../deploy/opennest/install.test.mjs ../../deploy/opennest/qualification/report.test.mjs ../../deploy/opennest/qualification/services.test.mjs",
    "smoke:native": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "@codexnest/protocol": "*",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "@nest-apps/kanban": "*",
    "fastify": "^5.6.1",
    "@opencode-ai/plugin": "1.19.5",
    "proxy-chain": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
