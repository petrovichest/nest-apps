{
  "name": "@codexnest/client",
  "version": "0.1.9",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:visual": "playwright test --config=playwright.config.ts",
    "test:visual:update": "playwright test --config=playwright.config.ts --update-snapshots",
    "docs:images": "playwright test --config=playwright.docs.config.ts",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run build && NEST_APP_PROVIDER=codex cap sync android && cd android && NEST_APP_PROVIDER=codex ./gradlew assembleDebug",
    "android:release": "npm run build && NEST_APP_PROVIDER=codex cap sync android && cd android && NEST_APP_PROVIDER=codex ./gradlew assembleRelease",
    "android:sync:claude": "NEST_APP_PROVIDER=claude cap sync android",
    "android:debug:claude": "npm run build:claude && npm run android:sync:claude && cd android && NEST_APP_PROVIDER=claude ./gradlew assembleDebug",
    "android:release:claude": "npm run build:claude && npm run android:sync:claude && cd android && NEST_APP_PROVIDER=claude ./gradlew assembleRelease",
    "dev:claude": "vite --mode claude",
    "build:claude": "tsc -b && vite build --mode claude",
    "smoke:claude": "npm run build:claude && node e2e/claude/smoke.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.4.3",
    "@capacitor/preferences": "8.0.0",
    "@codexnest/protocol": "*",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "8.4.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.1",
    "vite": "^7.1.12",
    "vitest": "^4.1.11"
  }
}
